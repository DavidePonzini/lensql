#: server/api/auth.py:32
msgid "Cannot login. Please check your username and password."
msgstr "Accesso non riuscito. Controlla nome utente e password."

#: server/api/auth.py:72
msgid "Username already exists. Please choose a different username."
msgstr "Il nome utente esiste già. Scegline un altro."

#: server/api/auth.py:80
msgid "Registration failed. Please try again."
msgstr "Registrazione non riuscita. Riprova."

#: server/api/auth.py:95
msgid "Old password is incorrect."
msgstr "La password è incorretta."

#: server/api/auth.py:98
msgid "Failed to reset password. Please try again."
msgstr "Impossibile reimpostare la password. Riprova."

#: server/api/auth.py:100
msgid "Password reset successfully."
msgstr "Password reimpostata con successo."

#: server/api/activities.py:65
msgid "You are not authorized to modify this activity."
msgstr "Non sei autorizzato a modificare questa attività."

#: server/api/activities.py:92 server/api/activities.py:207
msgid "You do not have access to this activity."
msgstr "Non hai accesso a questa attività."

#: server/api/activities.py:116
msgid "Activity does not exist."
msgstr "L’attività non esiste."

#: server/api/activities.py:143
msgid "This is a special activity and cannot be left."
msgstr "Questo è un’attività speciale e non può essere abbandonato"

#: server/api/activities.py:148
msgid ""
"You cannot leave this activity, as you are an owner and it has data "
"associated with it."
msgstr ""
"Non puoi abbandonare questo activity perché sei un proprietario e contiene"
" dei dati associati."

#: server/api/activities.py:174 server/api/activities.py:192
msgid "You are not an owner of this activity."
msgstr "Non sei un proprietario di questa attività."

#: server/api/activities.py:177
msgid "You cannot set yourself as an owner of this activity."
msgstr "Non puoi assegnarti come proprietario di questa attività."

#: server/api/activities.py:21
msgid "Failed to import activity. JSON syntax error at line %(line)s, column %(column)s: %(details)s."
msgstr "Impossibile importare l’attività. Errore di sintassi JSON alla riga %(line)s, colonna %(column)s: %(details)s."

#: server/api/activities.py:30
msgid "Failed to import activity. Missing required field: %(field)s."
msgstr "Impossibile importare l’attività. Campo obbligatorio mancante: %(field)s."

#: server/api/activities.py:37
msgid "Invalid activity content."
msgstr "Contenuto dell’attività non valido."

#: server/api/activities.py:39
msgid "Failed to import activity. %(details)s"
msgstr "Impossibile importare l’attività. %(details)s"

#: server/api/activities.py:43
msgid "Failed to import activity because the server encountered an error."
msgstr "Impossibile importare l’attività perché il server ha riscontrato un errore."

#: server/api/exercises.py:26
msgid "Activity ID is required."
msgstr "ID attività richiesto"

#: server/api/exercises.py:31 server/api/exercises.py:131
#: server/api/exercises.py:219
msgid "You are not a participant of this activity."
msgstr "Non sei un partecipante di questa attività."

#: server/api/exercises.py:58
msgid "You are not authorized to add exercises to this activity."
msgstr "Non sei autorizzato ad aggiungere esercizi a questa attività."

#: server/api/exercises.py:84 server/api/exercises.py:175
msgid "You are not authorized to edit this exercise."
msgstr "Non sei autorizzato a modificare questo esercizio."

#: server/api/exercises.py:104
msgid "You are not authorized to delete this exercise."
msgstr "Non sei autorizzato a cancellare questo esercizio."

#: server/api/exercises.py:109
msgid "Cannot delete exercise. There are queries associated with it."
msgstr "Impossibile eliminare l'esercizio. Ci sono query associate."

#: server/api/exercises.py:126
msgid "Exercise ID is required."
msgstr "ID esercizio richiesto."

#: server/api/exercises.py:149
msgid "You are not authorized to set learning objectives for this exercise."
msgstr ""
"Non sei autorizzato a impostare gli obiettivi didattici per questo "
"esercizio."

#: server/api/messages.py:64 server/api/messages.py:99
#: server/api/messages.py:133 server/api/messages.py:167
#: server/api/messages.py:201 server/api/messages.py:233
#: server/api/messages.py:265
msgid ""
"AI features are disabled for your account. Please contact support if you "
"believe this is an error."
msgstr ""
"Le funzionalità di intelligenza artificiale sono disattivate per il tuo "
"account. Contatta l’assistenza se ritieni che si tratti di un errore."

#: server/api/messages.py:277
msgid "Congratulations, I couldn't find any errors in your query!"
msgstr "Congratulazioni, non ho trovato alcun errore nella tua query!"

#: server/api/users.py:62 server/api/users.py:106 server/api/users.py:143
msgid "User is not a participant in the specified activity."
msgstr "L'utente non è un partecipante dell’attività specificato."

#: server/db/users/database.py:250 server/db/users/database.py:259
msgid "No tables found in the current search path."
msgstr ""

#: server/db/users/database.py:268
msgid "No constraints found in the current search path."
msgstr ""

#: server/db/users/database.py:422
msgid "No solution found for this exercise."
msgstr "Nessuna soluzione trovata per questo esercizio."

#: server/db/users/database.py:428
msgid "Your query is not supported. Please ensure it is a valid SQL SELECT query."
msgstr ""
"La tua query non è supportata. Assicurati che sia una query SQL SELECT "
"valida."

#: server/db/users/database.py:437
msgid ""
"Error executing teacher-provided solution. Have you initialized the "
"activity?"
msgstr ""
"Errore nell'esecuzione della soluzione fornita dall'insegnante. Hai "
"inizializzato il activity?"

#: server/db/users/database.py:445
msgid ""
"Your query has different columns from the solution. Cannot compare "
"results."
msgstr ""
"La tua query ha colonne diverse rispetto alla soluzione. Impossibile "
"confrontare i risultati."

#: server/db/users/database.py:446 server/db/users/database.py:458
msgid "Expected:"
msgstr "Atteso:"

#: server/db/users/database.py:447 server/db/users/database.py:459
msgid "Your query:"
msgstr "La tua query:"

#: server/db/users/database.py:457
msgid ""
"Your query has different data types from the solution. Cannot compare "
"results."
msgstr ""
"La tua query ha tipi di dati diversi rispetto alla soluzione. Impossibile"
" confrontare i risultati."

#: server/db/users/database.py:468
msgid "Your query returns the same values as the solution."
msgstr ""

#: server/gamification/__init__.py:8
msgid ""
"You don't have enough coins to use this feature. Check the Profile page "
"to learn how to earn more."
msgstr ""
"Non hai abbastanza monete per usare questa funzione. Consulta la pagina "
"del profilo per scoprire come guadagnarne di più."

#: server/sql/result/activity.py:47
msgid "Unexpected"
msgstr "Non previsto"

#: server/sql/result/activity.py:50
msgid "Missing"
msgstr "Mancante"

#: server/sql/result/activity.py:53
msgid "Correct"
msgstr "Corretto"

#: server/sql/result/activity.py:56
msgid "row"
msgstr "riga"

#: server/sql/result/activity.py:56
msgid "rows"
msgstr "righe"

#: server/sql/result/activity.py:57
msgid "column"
msgstr "colonna"

#: server/sql/result/activity.py:57
msgid "columns"
msgstr "colonne"

#: server/sql/result/activity.py:129
msgid "your query should not return this row"
msgstr "la tua query non dovrebbe ritornare questa riga"

#: server/sql/result/activity.py:130
msgid "your query should return this row but it does not"
msgstr "la tua query dovrebbe ritornare questa riga, ma non lo fa"

#: server/sql/result/activity.py:142
#, python-brace-format
msgid "{count} rows in your query are correct"
msgstr "{count} righe sono corrette"


#: server/api/activities.py
msgid "Invalid activity ID."
msgstr "ID dell’attività non valido."

#: server/api/activities.py
msgid "Activity IDs may contain only letters, numbers, underscores and hyphens."
msgstr "Gli ID delle attività possono contenere solo lettere, numeri, trattini bassi e trattini."

#: server/api/activities.py
msgid "This activity ID is already in use."
msgstr "Questo ID dell’attività è già in uso."

#: server/api/auth.py
msgid "Username and new password are required."
msgstr "Nome utente e nuova password sono obbligatori."

#: server/api/auth.py
msgid "Password must contain at least 8 characters, uppercase and lowercase letters, a number and a special character, and be at most 72 bytes."
msgstr "La password deve contenere almeno 8 caratteri, lettere maiuscole e minuscole, un numero e un carattere speciale, e non superare 72 byte."

msgid "Invalid request."
msgstr "Richiesta non valida."

msgid "Credits must be a non-negative integer."
msgstr "I crediti devono essere un numero intero non negativo."

msgid "Select at least one activity."
msgstr "Seleziona almeno un’attività."

msgid "You are not a teacher in all selected activities."
msgstr "Non sei docente in tutte le attività selezionate."

msgid "Select valid errors and counts (maximum 100 exercises), a title and a prefix."
msgstr "Seleziona errori e quantità validi (massimo 100 esercizi), un titolo e un prefisso."

msgid "Insufficient generation credits."
msgstr "Crediti di generazione insufficienti."

msgid "Generation failed. Your credits have been refunded."
msgstr "Generazione non riuscita. I crediti sono stati rimborsati."

msgid "Provide valid PostgreSQL dataset SQL with CREATE TABLE statements."
msgstr "Fornisci SQL PostgreSQL valido per il dataset, con istruzioni CREATE TABLE."
